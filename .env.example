# TBMS API Keys
TBMS_PUBLIC_KEY=your_tbms_public_key
TBMS_SECRET_KEY=your_tbms_secret_key
TBMS_BASE_URL=https://tbmslive.org/api

# OpenRouter AI API (for Document OCR)
# Recommended: google/gemini-2.5-flash or openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.5-flash

# PostgreSQL Database (e.g. Supabase or Neon Free Tier)
DATABASE_URL="postgresql://user:password@localhost:5432/flamecars_db"

# Cloudflare Pages / Cloudflare R2 Storage (Free Tier)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=flamecars-driver-documents

# SMS Gateway (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
